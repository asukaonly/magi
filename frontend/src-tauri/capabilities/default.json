{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability set for Magi desktop main window.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "magi-backend",
          "sidecar": true
        }
      ]
    },
    "shell:allow-kill",
    "process:default",
    "updater:default"
  ]
}
