{
  "name": "magi-ui",
  "version": "0.1.29",
  "description": "Magi AI Agent Framework - Web UI",
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=22.12 <23",
    "npm": "11.16.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.12 <23",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "11.16.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run type-check && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "type-check": "tsc --noEmit && tsc --project tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:ci": "vitest run",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "check": "npm run type-check && npm run lint && npm run check:boundaries && npm run contracts:check && npm run check:i18n",
    "check:full": "npm run check && npm run test:ci && npm run build",
    "contracts:generate": "node scripts/generate-api-contracts.mjs",
    "contracts:check": "node scripts/generate-api-contracts.mjs --check",
    "check:i18n": "node --test scripts/check-i18n.test.mjs && node scripts/check-i18n.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.0.0",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-log": "^2.8.0",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extensions": "^3.31.3",
    "@tiptap/html": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "axios": "^1.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "framer-motion": "^12.23.22",
    "i18next": "^25.8.11",
    "lucide-react": "^0.542.0",
    "react": "^18.2.0",
    "react-day-picker": "^8.10.2",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.71.2",
    "react-i18next": "^16.5.4",
    "react-markdown": "^10.1.0",
    "react-router": "^7.18.2",
    "recharts": "^2.10.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^3.4.0",
    "zod": "^4.3.6",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.8.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.1",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^6.0.2",
    "ajv": "^8.20.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^10.8.0",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^16.5.0",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.24",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.7"
  }
}
