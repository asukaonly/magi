            "turn": "#/components/schemas/TurnConfirmationRequest"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/components/schemas/TurnConfirmationRequest"
          },
          {
            "$ref": "#/components/schemas/AnswerConfirmationRequest"
          }
