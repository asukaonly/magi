  "info": {
    "title": "Magi device capability contracts",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/delivery/collector/{connection_id}": {
      "get": {
        "description": "Expose only the source protocol and generations, never center settings or secrets.",
        "operationId": "collector_scope_collector__connection_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "connection_id",
            "required": true,
            "schema": {
              "title": "Connection Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "x-magi-collector-source",
            "required": true,
            "schema": {
              "minLength": 1,
              "title": "X-Magi-Collector-Source",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CollectorScope"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Collector Scope"
      },
      "post": {
        "operationId": "claim_collector_collector__connection_id__post",
        "parameters": [
          {
            "in": "path",
            "name": "connection_id",
            "required": true,
            "schema": {
              "title": "Connection Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "x-magi-client-id",
            "required": true,
            "schema": {
              "minLength": 1,
              "title": "X-Magi-Client-Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "x-magi-collector-source",
            "required": true,
            "schema": {
              "minLength": 1,
              "title": "X-Magi-Collector-Source",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CollectorClaim"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CollectorScope"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Claim Collector"
      }
    },
    "/api/delivery/events": {
      "post": {
        "description": "ACK each fact only after its durable admission or idempotent materialization.",
        "operationId": "deliver_events_post",
        "parameters": [
          {
            "in": "header",
            "name": "x-magi-client-id",
            "required": true,
            "schema": {
              "minLength": 1,
              "title": "X-Magi-Client-Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeliveryBatch"
              }
            }
          },
          "required": true
        },
