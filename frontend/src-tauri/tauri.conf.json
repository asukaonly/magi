{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Magi",
  "version": "0.1.0",
  "identifier": "com.magi.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Magi",
        "width": 1280,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": true,
        "decorations": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all",
    "resources": ["sidecar-dist/"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhFRUI3MUU2NDg5QjkzMTUKUldRVms1dEk1bkhyanZLRmJ1WjVuQnlYekRGVE90ZFZjUDhzSzdHMHY3WXk3a2ZzOVdDa2N1ZFkK",
      "endpoints": ["https://github.com/asukaonly/magi/releases/latest/download/latest.json"]
    }
  }
}
