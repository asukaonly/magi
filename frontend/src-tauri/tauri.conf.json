{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Magi",
  "version": "0.1.0",
  "identifier": "com.magi.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Magi",
        "width": 1280,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": true,
        "decorations": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "externalBin": [
      "binaries/magi-backend"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg0NkZCOThCQTUzMEVEQUUKUldTdTdUQ2xpN2x2aEhnSko4R0JFc3crNnpMVWtuQXV0Nmg2N3R6ZnpES1VxaGRzSnFvdzNrUVcK",
      "endpoints": [
        "https://github.com/asukaonly/magi/releases/latest/download/latest.json"
      ]
    }
  }
}
