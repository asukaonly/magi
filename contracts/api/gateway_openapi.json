    "/api/events": {
      "get": {
        "summary": "Subscribe to state-change hints",
        "tags": [
          "Gateway"
        ],
        "responses": {
          "200": {
            "description": "Subscribe to state-change hints",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Last-Event-ID",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 100
            },
            "description": "Last processed SSE id, formatted as epoch:sequence."
          }
        ],
        "description": "SSE event name is magi; each data field is a GatewayEvent JSON envelope and id matches event_id. Retains at most 256 events / 8 MiB in memory. Missing, unknown, old, or different-epoch cursors yield resync_required: reload authoritative snapshots. These hints are not durable business messages. Epoch changes on process restart or reset; data_epoch in maintenance status is a separate mutation scope. Store the cursor only after handling a frame. Renew authentication then reconnect with bounded backoff/jitter; token expiry or revocation ends the stream. A lagging subscriber receives resync_required and is disconnected. Keep-alive comments occur every 15 seconds; capacity is 64 subscribers, excess requests return 429.",
        "operationId": "gateway_get_api_events"
      }
    },
    "/api/private-resource-tickets": {
      "post": {
        "summary": "Issue a short-lived private resource URL",
        "tags": [
          "Gateway"
        ],
        "responses": {
          "201": {
            "description": "Issue a short-lived private resource URL",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "const": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "access_url": {
                          "type": "string"
                        },
                        "expires_at_ms": {
                          "type": "integer"
                        }
                      },
                      "required": [
                        "access_url",
                        "expires_at_ms"
                      ]
                    }
                  },
                  "required": [
                    "success",
                    "data"
                  ]
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "chat_attachment"
                      },
                      "user_id": {
                        "type": "string"
                      },
                      "session_id": {
                        "type": "string"
                      },
                      "attachment_id": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "kind",
                      "user_id",
                      "session_id",
                      "attachment_id"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "timeline_asset"
                      },
                      "asset_ref": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "kind",
                      "asset_ref"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "user_avatar"
                      },
                      "filename": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "kind",
                      "filename"
                    ]
                  }
                ]
              }
            }
          }
        },
        "description": "Returned relative access_url contains a reusable 60-second resource_ticket bound to the exact path and query. Never put a device credential or session token in a URL.",
        "operationId": "gateway_post_api_private_resource_tickets"
      }
    },
