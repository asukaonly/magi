    "/api/server/info": {
      "get": {
        "summary": "Server identity and current epochs",
        "tags": [
          "Gateway"
        ],
        "responses": {
          "200": {
            "description": "Server identity and current epochs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "const": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "server_id": {
                          "type": "string"
                        },
                        "protocol_version": {
                          "type": "integer"
                        },
                        "events": {
                          "type": "object",
                          "properties": {
                            "epoch": {
                              "type": "string"
                            },
                            "sequence": {
                              "type": "integer"
                            }
                          },
                          "required": [
                            "epoch",
                            "sequence"
                          ]
                        },
                        "maintenance": {
                          "anyOf": [
                            {
                              "$ref": "#/components/schemas/GatewayMaintenanceStatus"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "service_ready": {
                          "type": "boolean"
                        },
                        "supervisor": {
                          "type": "object"
                        },
                        "plugin_execution": {
                          "const": "server"
                        }
                      },
                      "required": [
                        "server_id",
                        "protocol_version",
                        "events",
                        "maintenance",
                        "service_ready",
                        "supervisor",
                        "plugin_execution"
                      ]
                    }
                  },
                  "required": [
                    "success",
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid or rejected operation"
          },
          "429": {
            "description": "Authentication work queue is busy"
          }
        },
        "operationId": "gateway_get_api_server_info"
      }
    },
    "/api/auth/pair": {
      "post": {
        "summary": "Redeem one single-use pairing grant",
        "tags": [
          "Gateway"
        ],
        "responses": {
          "200": {
            "description": "Redeem one single-use pairing grant",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "const": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/GatewayClientGrant"
                    }
                  },
                  "required": [
                    "success",
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid or rejected operation"
          },
          "429": {
            "description": "Authentication work queue is busy"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  }
                },
                "required": [
                  "name"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "description": "Send the pairing_token in x-magi-session-token. Grants expire after 30 minutes and are consumed once. Persist client_credential securely; it is an opaque device credential, not an access token or JWT. A lost response requires a new pairing grant; do not assume redemption can be replayed.",
        "operationId": "gateway_post_api_auth_pair"
      }
    },
    "/api/auth/session": {
      "post": {
        "summary": "Exchange a device credential for an access session",
        "tags": [
          "Gateway"
        ],
        "responses": {
          "200": {
            "description": "Exchange a device credential for an access session",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "const": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/GatewayAccessSession"
                    }
                  },
                  "required": [
                    "success",
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid or rejected operation"
          },
          "429": {
            "description": "Authentication work queue is busy"
          }
        },
        "description": "Send client_credential in x-magi-session-token, with no request body. The returned access_token expires after 15 minutes. Exchange the device credential again before expiry or after a session rejection; a revoked device must pair again.",
        "operationId": "gateway_post_api_auth_session"
      }
    },
