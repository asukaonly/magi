            "type": "string"
          },
          "kind": {
            "const": "ask_response",
            "title": "Kind",
            "type": "string"
          },
          "request_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Request Id",
            "type": "string"
          },
          "session_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Session Id",
