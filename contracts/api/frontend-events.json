          "title",
          "last_message_preview",
          "last_user_message_preview",
          "title_overridden",
          "last_timestamp",
          "message_count",
          "workspace_path",
          "history_version"
        ],
        "title": "ChatSessionSummary",
        "type": "object"
      },
      "RunEvent": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "stdout",
              "stderr",
              "tool_call",
              "tool_result",
