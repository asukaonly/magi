{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability set for Magi desktop main window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    {
      "identifier": "shell:allow-open",
      "allow": [
        { "url": "^https?://.+" },
        { "url": "^mailto:.+" },
        { "url": "^tel:.+" },
        { "url": "^x-apple\\.systempreferences:.+" },
        { "url": "^ms-settings:.+" }
      ]
    },
    "process:default",
    "log:default",
    "updater:default",
    "autostart:default"
  ]
}
