{
  "components": {
    "schemas": {
      "DownloadProgress": {
        "properties": {
          "downloaded_bytes": {
            "default": 0,
            "minimum": 0,
            "title": "Downloaded Bytes",
            "type": "integer"
          },
          "eta_seconds": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Eta Seconds"
          },
          "files_completed": {
            "default": 0,
            "minimum": 0,
            "title": "Files Completed",
            "type": "integer"
          },
          "phase": {
            "default": "connecting",
            "enum": [
              "connecting",
              "downloading",
              "retrying",
              "verifying",
              "completed",
              "cancelled",
              "failed"
            ],
            "title": "Phase",
            "type": "string"
          },
          "speed_bps": {
            "default": 0,
            "minimum": 0,
            "title": "Speed Bps",
            "type": "number"
          },
          "total_bytes": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Total Bytes"
          },
          "total_files": {
            "default": 0,
            "minimum": 0,
            "title": "Total Files",
            "type": "integer"
          }
        },
        "required": [
          "phase",
          "downloaded_bytes",
          "total_bytes",
          "speed_bps",
          "eta_seconds",
          "files_completed",
          "total_files"
        ],
        "title": "DownloadProgress",
        "type": "object"
      },
      "ModelDownloadStatus": {
        "properties": {
          "download": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DownloadProgress"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Error"
          },
          "model_id": {
            "title": "Model Id",
            "type": "string"
          },
          "status": {
            "enum": [
              "downloading",
              "completed",
              "failed",
              "cancelled",
              "not_found"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "model_id",
          "status",
          "download",
          "error"
        ],
        "title": "ModelDownloadStatus",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Magi model download contracts",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {}
}
