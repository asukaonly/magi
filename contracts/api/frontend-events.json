        "type": "object"
      },
      "RunTrigger": {
        "description": "Describes how / why a run was started.\n\nCarried on ``AgentRun.trigger`` so observability, delivery, and retract\npropagation can preserve provenance.",
        "properties": {
          "correlation": {
            "items": {
              "type": "string"
            },
            "title": "Correlation",
            "type": "array"
          },
          "payload": {
            "additionalProperties": true,
            "title": "Payload",
            "type": "object"
          },
          "priority": {
