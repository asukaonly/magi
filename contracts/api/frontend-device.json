          },
          "payload": {
            "discriminator": {
              "mapping": {
                "notification_read": "#/components/schemas/NotificationRead",
                "plugin_event": "#/components/schemas/PluginEvent",
                "source_observation": "#/components/schemas/SourceObservation"
              },
              "propertyName": "kind"
