            "type": "integer"
          },
          "last_message_preview": {
            "title": "Last Message Preview",
            "type": "string"
          },
          "last_timestamp": {
            "title": "Last Timestamp",
            "type": "integer"
          },
          "last_user_message_preview": {
            "title": "Last User Message Preview",
            "type": "string"
          },
          "message_count": {
            "title": "Message Count",
            "type": "integer"
          },
          "session_id": {
            "title": "Session Id",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "title_overridden": {
            "title": "Title Overridden",
            "type": "boolean"
          },
          "workspace_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Workspace Path"
          }
        },
        "required": [
