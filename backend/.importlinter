    magi.api.services.message_dispatch_service -> magi.chat.read_service
    magi.api.services.message_dispatch_service -> magi.transport.chat_events
    magi.api.services.personality_bootstrap_messages -> magi.chat.contracts
    magi.api.services.personality_bootstrap_messages -> magi.chat.provider
    magi.api.services.personality_bootstrap_messages -> magi.transport.chat_events
    magi.awareness.lifecycle -> magi.timeline.adapter
